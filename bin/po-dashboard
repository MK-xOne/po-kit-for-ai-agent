#!/usr/bin/env python3
"""po-dashboard: a desktop window showing the gate events of a po serve.

    po-dashboard [--url <url>] [--team-url <url>] [--decisions-url <url>] [--answer-url <url>] [--install-dir <dir>] [--view events|team|decisions|reports] [--theme auto|light|dark] [--all] [--size WxH] [--check] [--screenshot <png>] [--screenshot-delay <s>]

The URL is the events JSON (a JSON array or one object per line, e.g. the
/events.json of `po serve`); --url or PO_DASHBOARD_URL, no default. GTK 4 and
PyGObject (pacman -S gtk4 python-gobject); the logic is lib/po/dashboard_core.py.
--team-url or PO_DASHBOARD_TEAM_URL (no default) adds a Team view, a header toggle Events | Team, reading a
JSON array of {agent, model?, state, now, owns[], free, limit_until?, usage?}; without it there is no toggle. Drag a Team line
(or Alt+Up/Down on a focused one) to reorder; the order is saved in $XDG_CONFIG_HOME/po-dashboard/team-order.json
(default ~/.config; PO_DASHBOARD_TEAM_ORDER names another file).
--decisions-url or PO_DASHBOARD_DECISIONS_URL (no default) adds a Decisions view to the toggle, read-only:
a JSON array of {project, item, title, waiting_for, asked_at, thread_url?, asked_by?, kind?, id?, ...}: Choices first, then
Actions, then unformatted and legacy entries, oldest asked first in each group; an Actions toggle (saved in $XDG_CONFIG_HOME/po-dashboard/decisions.json)
hides the Action entries. One line per entry, asked_at as "3h ago" (local time in the tooltip), thread_url as copyable muted text. Esc closes the window.
--answer-url or PO_DASHBOARD_ANSWER_URL (no default; --answer-url wins) sets an http(s) answer sink:
when it is set, expanded decision cards gain pick controls (one radio row per option plus an
`or write your own` text box for a Choice; Pass and Failed with a step chooser and note for an
Action; a free-text box for an unformatted entry) and a Send button that POSTs one JSON object
{answer_id, id, project, item, kind, option, text, result, step, note, answered_at, client} per
answer; PO_DASHBOARD_ANSWER_TOKEN (env only, never a flag) is sent as a bearer token. The card
shows the result: `answered · sent` (muted, controls disabled; 200/201), `already answered`
(409, controls disabled), `no longer waiting` (404), `refused by <host>: <code>` (401/403) or
`not sent: <reason>` (anything else or no connection), each failed state with a Retry button that
re-posts the same body. The POST runs in a worker thread and never blocks the UI; the answer
state is kept in the window state keyed by id, re-applied on rebuild, pruned when the entry
leaves the feed. Without the sink the view stays read-only (`read-only` shown once in the
status line). An action may carry `requires` {package, sha256}: the card shows the package name, and above
each project's cards one `Install this build` block (the newest card's build) gives the sha256 check and the
`sudo pacman -U` command, each with a Copy button, built from --install-dir or PO_DASHBOARD_INSTALL_DIR (an
absolute path, no default; unset, the block says `set install_dir`); a card needing another build is marked
`needs <package>: install it first`. No Enter-to-send, no confirmation dialog. Exit codes: 1 usage, 2 GTK or PyGObject missing
(or, with --check, the feed unreachable).
"""
import argparse
import datetime
import math
import os
import sys
import threading
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "po"))
import dashboard_core as core  # noqa: E402
import dashboard_reports as reports  # noqa: E402

def die(msg, code=1):
    sys.stderr.write("po-dashboard: %s\n" % msg)
    sys.exit(code)


def local_tz():
    """The viewer's own zone, for the day and hour buckets of the report charts."""
    return datetime.datetime.now().astimezone().tzinfo


def reports_empty(data):
    return not (data.get("total") or data.get("rows"))


def load_gtk():
    try:
        import gi

        gi.require_version("Gtk", "4.0")
        gi.require_version("Gdk", "4.0")
        from gi.repository import GLib, Gdk, Gtk, Gio, Graphene, Pango
    except (ImportError, ValueError, AttributeError) as e:
        die("needs GTK 4 and PyGObject (pacman -S gtk4 python-gobject): %s" % e, 2)
    return GLib, Gdk, Gtk, Gio, Graphene, Pango


def main():
    ap = argparse.ArgumentParser(prog="po-dashboard", add_help=True)
    ap.add_argument("--url", help="events JSON URL (default: $%s)" % core.URL_ENV)
    ap.add_argument("--team-url", help="team feed JSON URL or file (default: $%s; none = no Team view)" % core.TEAM_URL_ENV)
    ap.add_argument("--decisions-url", help="decisions feed JSON URL or file (default: $%s; none = no Decisions view)" % core.DECISIONS_URL_ENV)
    ap.add_argument("--projects-url", help="projects feed JSON URL or file (default: $%s; none = no Projects view)" % core.PROJECTS_URL_ENV)
    ap.add_argument("--answer-url", help="where to POST answers (default: $%s; none = read-only Decisions)" % core.ANSWER_URL_ENV)
    ap.add_argument("--install-dir", help="absolute dir holding the builds that cards name with requires (default: $%s; none = no install command)" % core.INSTALL_DIR_ENV)
    ap.add_argument("--view", choices=("events", "team", "decisions", "projects", "reports"), default="events", help="the view to start in (team, decisions and projects need their feed)")
    ap.add_argument("--project", metavar="NAME", help="with --view projects: open straight on this project's screen")
    ap.add_argument("--theme", choices=("auto", "light", "dark"), default="auto")
    ap.add_argument("--all", action="store_true", help="start with every event shown (Show all on)")
    ap.add_argument("--size", metavar="WxH", default="760x640", help="initial window size (default 760x640)")
    ap.add_argument("--check", action="store_true", help="print the rows the window would show, without a display")
    ap.add_argument("--screenshot", metavar="PNG", help="save the window once it has data, then quit")
    ap.add_argument("--screenshot-delay", metavar="SECONDS", type=float, default=0.6, help="wait this long after the first data before the screenshot (default 0.6)")
    a = ap.parse_args()
    try:
        width, height = (int(n) for n in a.size.lower().split("x"))
        if width < 200 or height < 200:
            raise ValueError
    except ValueError:
        ap.error("--size must be WxH, both at least 200")
    try:
        url = core.resolve_url(a.url)
        team_url = core.resolve_team_url(a.team_url)
        decisions_url = core.resolve_decisions_url(a.decisions_url)
        projects_url = core.resolve_projects_url(a.projects_url)
        answer_url = core.resolve_answer_url(a.answer_url)
        install_dir = core.resolve_install_dir(a.install_dir)
    except core.DashboardError as e:
        die(str(e))
    if a.view == "team" and not team_url:
        die("--view team needs a team feed: pass --team-url or set %s" % core.TEAM_URL_ENV)
    if a.view == "decisions" and not decisions_url:
        die("--view decisions needs a decisions feed: pass --decisions-url or set %s" % core.DECISIONS_URL_ENV)
    if a.project and a.view != "projects":
        die("--project needs --view projects")
    if a.view == "projects" and not projects_url:
        die("--view projects needs a projects feed: pass --projects-url or set %s" % core.PROJECTS_URL_ENV)
    if a.check:
        try:
            print("\n".join(core.check_lines(core.parse_events(core.fetch(url)), a.all)))
            if team_url:
                order = core.load_team_order(core.team_order_path())
                print("team:")
                print("\n".join(core.team_check_lines(core.apply_team_order(core.parse_team(core.fetch(team_url)), order))))
            if decisions_url:
                print("decisions:")
                decisions = core.parse_decisions(core.fetch(decisions_url))
                print("\n".join(core.decision_check_lines(decisions) + core.install_check_lines(decisions, install_dir)))
            if projects_url:
                print("projects:")
                print("\n".join(core.project_check_lines(core.parse_projects(core.fetch(projects_url)))))
        except core.DashboardError as e:
            die(str(e), 2)
        return
    GLib, Gdk, Gtk, Gio, Graphene, Pango = load_gtk()

    class Chart(Gtk.Widget):
        """One report chart: the shapes of dashboard_reports, painted with GTK's snapshot (no drawing library
        beyond GTK itself). Its accessible label and tooltip are the chart's numbers as a sentence."""

        def __init__(self, layout, data, text, dark):
            super().__init__(hexpand=True, focusable=True, accessible_role=Gtk.AccessibleRole.IMG)
            self.layout, self.data, self.dark = layout, data, dark
            self.add_css_class("po-chart-draw")
            self.set_tooltip_text(text)
            self.update_property([Gtk.AccessibleProperty.LABEL], [text])

        def do_get_request_mode(self):
            return Gtk.SizeRequestMode.HEIGHT_FOR_WIDTH

        def do_measure(self, orientation, for_size):
            if orientation == Gtk.Orientation.HORIZONTAL:
                return 320, 640, -1, -1
            h = int(math.ceil(self.layout(self.data, max(for_size, 320))[0]))
            return h, h, -1, -1

        def colour(self, key):
            pal = core.PALETTES["dark" if self.dark else "light"]
            hexcolor = pal["series"][key[1]] if isinstance(key, tuple) else pal[key]
            rgba = Gdk.RGBA()
            rgba.parse(hexcolor)
            return rgba

        def box(self, snap, rgba, x, y, w, h):
            snap.append_color(rgba, Graphene.Rect().init(x, y, w, h))

        def do_snapshot(self, snap):
            width = self.get_width()
            if width <= 0:
                return
            for shape in self.layout(self.data, width)[1]:
                kind = shape[0]
                if kind == "rect":
                    _k, x, y, w, h, key, hatched = shape
                    rgba = self.colour(key)
                    if not hatched:
                        self.box(snap, rgba, x, y, w, h)
                        continue
                    for bx, by, bw, bh in ((x, y, w, 1), (x, y + h - 1, w, 1), (x, y, 1, h), (x + w - 1, y, 1, h)):
                        self.box(snap, rgba, bx, by, bw, bh)
                    snap.push_clip(Graphene.Rect().init(x, y, w, h))
                    for k in range(-int(h), int(w), 5):  # diagonal lines, bottom left to top right
                        snap.save()
                        snap.translate(Graphene.Point().init(x + k, y + h))
                        snap.rotate(-45)
                        self.box(snap, rgba, 0, 0, h * 1.4143, 1.5)
                        snap.restore()
                    snap.pop()
                elif kind == "line":
                    _k, x1, y1, x2, _y2, key = shape
                    self.box(snap, self.colour(key), x1, y1, x2 - x1, 1)
                else:
                    _k, x, y, text, key, align = shape
                    lay = self.create_pango_layout(text)
                    desc = Pango.FontDescription()
                    desc.set_absolute_size(12 * Pango.SCALE)
                    lay.set_font_description(desc)
                    tw = lay.get_pixel_size()[0]
                    x -= tw if align == "end" else tw / 2 if align == "middle" else 0
                    snap.save()
                    snap.translate(Graphene.Point().init(x, y))
                    snap.append_layout(lay, self.colour(key))
                    snap.restore()

    class Dashboard:
        def __init__(self, app):
            self.show_all = a.all
            self.events = []
            self.seen = None  # event keys already shown; None until the first fetch, so nothing is new then
            self.born = {}  # event key -> time.monotonic() when it appeared while the window was open
            self.cards = []  # (card, event key, highlight step now) of the Events view
            self.team = []
            self.team_text = None
            self.order_path = core.team_order_path()
            self.team_order = core.load_team_order(self.order_path)  # saved agent names, the viewer's own order
            self.team_shown = []  # agent names as the Team view shows them now
            self.team_cards = {}  # agent name -> its card, to keep focus on a moved line
            self.sorts = {"events": None, "team": None}  # per view: None (the default order) or (column key, descending)
            self.heads = {"events": {}, "team": {}}  # view -> column key -> (header button, arrow label)
            self.event_groups = [Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL) for _ in core.COLUMNS]
            self.team_groups = [Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL) for _ in range(4)]
            self.decisions = []
            self.decisions_expanded = set()  # (project, item) of the cards the user opened
            self.filter_path = core.decisions_filter_path()
            self.actions_shown = core.load_actions_shown(self.filter_path)  # the viewer's own Actions filter
            self.decisions_shown = core.load_decisions_shown(self.filter_path)  # the viewer's own Decisions filter
            self.decisions_text = None
            self.answer_url = answer_url
            self.install_dir = install_dir
            self.answer_token = os.environ.get(core.ANSWER_TOKEN_ENV, "")
            self.answers = {}  # entry id -> {"answer_id": str, "body": dict, "display": str}
            self.drafts = {}  # entry id -> unsent answer draft (window-level, survives redraw)
            self.answer_views = {}  # (entry id, "text" or "note") -> the TextView of that answer box now
            self.asked_labels = []  # (label, entry): the "asked … ago" texts, moved on in place at each refresh
            self.read_only_said = False  # shows "read-only" once in the status line
            self.view = "events"
            self.events_failed = False
            self.team_failed = False
            self.decisions_failed = False
            self.projects = None  # the last good projects feed 
            self.projects_note = ""
            self.projects_failed = False
            self.cards_by_child = []
            self.last_text = None
            self.provider = None
            self.shot_done = False
            logo_dir = os.path.abspath(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "assets", "logo"))
            if os.path.exists(os.path.join(logo_dir, "po-kit-icon-512.png")):  # GTK4 has no icon-from-file: use the theme
                Gtk.IconTheme.get_for_display(Gdk.Display.get_default()).add_search_path(logo_dir)
                Gtk.Window.set_default_icon_name("po-kit-icon-512")
            self.win = Gtk.ApplicationWindow(application=app, title="po events")
            self.win.set_default_size(width, height)
            self.win.add_css_class("po-dashboard")

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            header.add_css_class("po-header")
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            title = self.title_label = Gtk.Label(label="Gate events", xalign=0)
            title.add_css_class("po-title")
            self.status = Gtk.Label(label="loading…", xalign=0)
            self.status.add_css_class("po-status")
            texts.append(title)
            texts.append(self.status)
            self.toggle = Gtk.ToggleButton(label="Show all")
            self.toggle.add_css_class("po-small")
            if a.all:
                self.toggle.set_active(True)
                self.toggle.set_label("Show last %d" % core.LAST)
            self.toggle.connect("toggled", self.on_toggle)
            header.append(texts)
            self.view_buttons = {}
            if team_url or decisions_url or projects_url:
                views = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, valign=Gtk.Align.CENTER)
                shown = [("events", "Events")] + ([("team", "Team")] if team_url else []) + ([("decisions", "Decisions")] if decisions_url else []) + ([("projects", "Projects")] if projects_url else [])
                first = None
                for name, text in shown:
                    b = Gtk.ToggleButton(label=text, active=first is None, group=first)
                    first = first or b
                    b.add_css_class("po-view")
                    b.connect("toggled", self.on_view, name)
                    views.append(b)
                    self.view_buttons[name] = b
                header.append(views)

            self.reports_on = a.view == "reports"  # the Reports pane replaces the Events list; kept across refreshes
            self.report_range = core.REPORT_DEFAULT
            self.reports_button = Gtk.ToggleButton(label="Reports", active=self.reports_on)
            self.reports_button.add_css_class("po-small")
            self.reports_button.connect("toggled", self.on_reports)
            self.subrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin_top=4, margin_bottom=2)
            self.subrow.add_css_class("po-subrow")
            self.actions_toggle = Gtk.ToggleButton(label="Actions", active=self.actions_shown)
            self.actions_toggle.add_css_class("po-small")
            self.actions_toggle.connect("toggled", self.on_actions)
            self.decisions_toggle = Gtk.ToggleButton(label="Decisions", active=self.decisions_shown)
            self.decisions_toggle.add_css_class("po-small")
            self.decisions_toggle.connect("toggled", self.on_decisions_toggle)
            self.subrow.append(self.toggle)
            self.subrow.append(self.reports_button)
            self.subrow.append(self.actions_toggle)
            self.subrow.append(self.decisions_toggle)
            self.subrow_show(a.view)

            self.error = Gtk.Label(label="", xalign=0, wrap=True, margin_start=36, margin_end=36)
            self.error.add_css_class("po-error")
            self.error.set_visible(False)
            self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.list.add_css_class("po-list")
            scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            scroll.set_child(self.list)
            self.team_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.team_list.add_css_class("po-list")
            team_scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            team_scroll.set_child(self.team_list)
            self.stack = Gtk.Stack(vexpand=True)
            event_head = self.column_header("events", [(k, t, g, grow) for (k, t, _w, _m, grow), g in zip(core.COLUMNS, self.event_groups)], note_slot=True)
            team_cols = list(zip(core.TEAM_COLUMNS, self.team_groups + [None]))
            team_head = self.column_header("team", [(k, k, g, k == "owns") for k, g in team_cols])
            for view, head, body in (("events", event_head, scroll), ("team", team_head, team_scroll)):
                page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                page.append(head)
                page.append(body)
                if view == "events":
                    self.events_page = page
                    continue
                self.stack.add_named(page, view)
            self.events_stack = Gtk.Stack(vexpand=True)  # the Events view: the list, or the Reports pane
            self.events_stack.add_named(self.events_page, "list")
            self.events_stack.add_named(self.build_reports(), "reports")
            self.events_stack.set_visible_child_name("reports" if self.reports_on else "list")
            self.stack.add_named(self.events_stack, "events")
            self.stack.set_visible_child_name("events")  # not the first page added (Team): v0.32 showed it at start
            self.decisions_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.decisions_list.add_css_class("po-list")
            self.decisions_scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            self.decisions_scroll.set_child(self.decisions_list)
            self.stack.add_named(self.decisions_scroll, "decisions")
            self.projects_sig = None  # what the cards show now; a refresh that changes nothing touches nothing
            self.pstate = core.project_view_state(a.project)  # open project (None = overview) and per-project filter
            self.pscreen_sig = None
            self.projects_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.projects_list.add_css_class("po-list")
            self.projects_scroll = projects_scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            projects_scroll.set_child(self.projects_list)
            self.projects_stack = Gtk.Stack()
            self.projects_stack.add_named(projects_scroll, "overview")
            self.pscreen = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=36, margin_end=36, margin_top=6)
            self.projects_stack.add_named(self.pscreen, "screen")
            self.stack.add_named(self.projects_stack, "projects")
            self.projects_error = Gtk.Label(label="", xalign=0, wrap=True, margin_start=36, margin_end=36)
            self.projects_error.add_css_class("po-error")
            self.projects_error.set_visible(False)
            self.team_error = Gtk.Label(label="", xalign=0, wrap=True, margin_start=36, margin_end=36)
            self.team_error.add_css_class("po-error")
            self.team_error.set_visible(False)
            self.decisions_error = Gtk.Label(label="", xalign=0, wrap=True, margin_start=36, margin_end=36)
            self.decisions_error.add_css_class("po-error")
            self.decisions_error.set_visible(False)

            outer.append(header)
            outer.append(self.subrow)
            outer.append(self.error)
            outer.append(self.team_error)
            outer.append(self.decisions_error)
            outer.append(self.projects_error)
            outer.append(self.stack)
            self.win.set_child(outer)
            if a.view in self.view_buttons:
                self.view_buttons[a.view].set_active(True)

            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self.on_key)
            self.win.add_controller(keys)

            self.settings = Gtk.Settings.get_default()
            for prop in ("gtk-application-prefer-dark-theme", "gtk-interface-color-scheme"):
                try:
                    self.settings.connect("notify::" + prop, lambda *_: self.apply_css())
                except TypeError:
                    pass
            self.apply_css()
            self.win.present()
            self.refresh()
            GLib.timeout_add(core.INTERVAL_MS, self.tick)
            GLib.timeout_add(500, self.fade_tick)

        # -- style --
        def dark(self):
            if a.theme != "auto":
                return a.theme == "dark"
            s = self.settings
            try:
                if s.get_property("gtk-interface-color-scheme") == Gtk.InterfaceColorScheme.DARK:
                    return True
            except (TypeError, AttributeError):
                pass
            return bool(s.get_property("gtk-application-prefer-dark-theme"))

        def apply_css(self):
            display = Gdk.Display.get_default()
            if self.provider is not None:
                Gtk.StyleContext.remove_provider_for_display(display, self.provider)
            self.provider = Gtk.CssProvider()
            text = core.css("dark" if self.dark() else "light")
            if hasattr(self.provider, "load_from_string"):
                self.provider.load_from_string(text)
            else:
                self.provider.load_from_data(text.encode("utf-8"))
            Gtk.StyleContext.add_provider_for_display(display, self.provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
            if hasattr(self, "chart_box"):
                self.redraw_reports()  # the charts take their colours from the variant

        # -- the new-event highlight --
        def step_of(self, key):
            born = self.born.get(key)
            if born is None:
                return 0
            reduced = not self.settings.get_property("gtk-enable-animations")
            return core.fade_step(time.monotonic() - born, reduced)

        def fade_tick(self):
            for i, (card, key, step) in enumerate(self.cards):
                n = self.step_of(key)
                if n != step:
                    if step:
                        card.remove_css_class("po-fade-%d" % step)
                    if n:
                        card.add_css_class("po-fade-%d" % n)
                    self.cards[i] = (card, key, n)
            return True

        # -- data --
        def tick(self):
            self.refresh()
            return True

        def refresh(self):
            threading.Thread(target=self.fetch_worker, daemon=True).start()
            if team_url:
                threading.Thread(target=self.team_worker, daemon=True).start()
            if decisions_url:
                threading.Thread(target=self.decisions_worker, daemon=True).start()
            if projects_url:
                threading.Thread(target=self.projects_worker, daemon=True).start()

        def projects_worker(self):
            projects, note = core.load_projects(projects_url, self.projects)
            GLib.idle_add(self.on_projects, projects, note)

        def on_projects(self, projects, note):
            self.projects, self.projects_note = projects, note
            self.projects_failed = bool(note)
            self.projects_error.set_text(note)
            self.projects_error.set_visible(self.view == "projects" and self.projects_failed)
            self.redraw_projects()
            self.show_status()
            if a.screenshot and not self.shot_done and self.view == "projects":
                self.shot_done = True
                GLib.timeout_add(int(a.screenshot_delay * 1000), self.screenshot)
            return False

        def open_project(self, name):
            self.pstate = core.project_state_open(self.pstate, name)
            self.redraw_project_screen()

        def back_to_overview(self):
            name = self.pstate["open"]
            self.pstate = core.project_state_back(self.pstate)
            self.redraw_project_screen()
            for child, n in self.cards_by_child:  # the project stays highlighted: its card takes the focus back
                if n == name:
                    child.grab_focus()

        def set_project_filter(self, key):
            self.pstate = core.project_state_set_filter(self.pstate, self.pstate["open"], key)
            self.redraw_project_screen()

        def redraw_project_screen(self):
            """Show the open project's screen, or the overview; a refresh that changes nothing touches nothing."""
            self.pstate = core.project_state_reconcile(self.pstate, self.projects)
            name = self.pstate["open"]
            pr = next((p for p in self.projects or [] if p["project"] == name), None)
            if pr is None:
                self.pscreen_sig = None
                self.projects_stack.set_visible_child_name("overview")
                return
            screen = core.project_screen(pr, core.project_state_filter(self.pstate, name))
            sig = (screen["text"], [(f["key"], f["count"]) for f in screen["filters"]], core.project_state_filter(self.pstate, name),
                   [(r["item"], r["title"], r["status"], tuple(r["agents"])) for r in screen["rows"]])
            self.projects_stack.set_visible_child_name("screen")
            if sig == self.pscreen_sig:
                return
            self.pscreen_sig = sig
            for c in list(self.pscreen):
                self.pscreen.remove(c)
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            back = Gtk.Button(label="\u2190 Back")
            back.connect("clicked", lambda _b: self.back_to_overview())
            head.append(back)
            head.append(self.label("\u25cf", "po-light-%s" % screen["light"]))
            head.append(self.label(screen["name"], "po-title", hexpand=True, ellipsize=3))
            head.append(self.label(screen["light"], "po-muted"))
            head.set_tooltip_text(screen["text"])
            self.pscreen.append(head)
            bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            first = None
            current = core.project_state_filter(self.pstate, name)
            for f in screen["filters"]:
                b = Gtk.ToggleButton(label="%s %d" % (f["label"], f["count"]), active=f["key"] == current, group=first)
                first = first or b
                b.connect("toggled", lambda btn, k=f["key"]: btn.get_active() and self.set_project_filter(k))
                bar.append(b)
            self.pscreen.append(bar)
            rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            for r in screen["rows"]:
                line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                line.add_css_class("po-card")
                line.append(self.label(r["item"], "po-text", width_chars=6))
                line.append(self.label(r["title"], "po-text", hexpand=True, ellipsize=3))
                line.append(self.label(r["status"], "po-muted", width_chars=7))
                agents = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                if r["dash"]:
                    agents.append(self.label("\u2013", "po-muted"))
                for ag in r["agents"]:
                    if r["live"]:
                        agents.append(self.label("\u25cf", "po-live"))
                    agents.append(self.label(ag, "po-text"))
                line.append(agents)
                rows.append(line)
            if not screen["rows"]:
                rows.append(self.label("no items", "po-muted"))
            scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            scroll.set_child(rows)
            self.pscreen.append(scroll)

        def redraw_projects(self):
            cards = [core.project_card(pr) for pr in self.projects or []]
            sig = [(c["name"], c["text"]) for c in cards]
            self.redraw_project_screen()
            if sig == self.projects_sig:
                return
            self.projects_sig = sig
            vadj = self.projects_scroll.get_vadjustment()
            scroll = vadj.get_value()
            focused = None
            for c in self.cards_by_child:
                if c[0].has_focus():
                    focused = c[1]
            self.cards_by_child = []
            for c in list(self.projects_list):
                self.projects_list.remove(c)
            if not cards:
                self.projects_list.append(self.label("no projects", "po-muted"))
                return
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, min_children_per_line=1,
                               max_children_per_line=6, column_spacing=12, row_spacing=4, valign=Gtk.Align.START)
            flow.connect("child-activated", lambda _f, child: self.open_project(child.project_name))
            restore = None
            for c in cards:
                child = Gtk.FlowBoxChild(focusable=True)
                child.project_name = c["name"]
                child.set_tooltip_text(c["text"])
                child.update_property([Gtk.AccessibleProperty.LABEL], [c["text"]])
                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                card.add_css_class("po-card")
                top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                top.append(self.label("●", "po-light-%s" % c["light"]))
                top.append(self.label(c["name"], "po-text", hexpand=True, ellipsize=3))
                card.append(top)
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                for lab, key in (("TODO", "todo"), ("DOING", "doing"), ("DONE", "done")):
                    row.append(self.label("%s %d" % (lab, c["counts"][key]), "po-muted"))
                card.append(row)
                child.set_child(card)
                child.add_css_class("po-pcard")
                flow.append(child)
                self.cards_by_child.append((child, c["name"]))
                if c["name"] == focused:
                    restore = child
            self.projects_list.append(flow)
            if restore is not None:
                restore.grab_focus()
            GLib.idle_add(lambda: vadj.set_value(scroll) and False)

        def decisions_worker(self):
            try:
                text = core.fetch(decisions_url)
                GLib.idle_add(self.on_decisions, text, core.parse_decisions(text))
            except core.DashboardError as e:
                GLib.idle_add(self.on_decisions_error, str(e))

        def on_decisions_error(self, msg):
            self.decisions_error.set_text(msg + " (showing the last decisions data)" if self.decisions_text is not None else msg)
            self.decisions_failed = True
            self.decisions_error.set_visible(self.view == "decisions")
            self.show_status()
            return False

        def on_decisions(self, text, decisions):
            self.decisions_failed = False
            self.decisions_error.set_visible(False)
            same = core.decisions_same(self.decisions if self.decisions_text is not None else None, decisions)
            self.decisions_text, self.decisions = text, decisions
            if same:  # nothing changed: the cards (and the box being typed in) stay; the clock text moves on
                for label, entry in self.asked_labels:
                    label.set_text("asked " + core.decision_row(entry)["asked"])
            else:
                self.redraw_decisions()
            self.show_status()
            return False

        def team_worker(self):
            try:
                text = core.fetch(team_url)
                GLib.idle_add(self.on_team, text, core.parse_team(text))
            except core.DashboardError as e:
                GLib.idle_add(self.on_team_error, str(e))

        def on_team_error(self, msg):
            self.team_error.set_text(msg + " (showing the last team data)" if self.team_text is not None else msg)
            self.team_failed = True
            self.team_error.set_visible(self.view == "team")
            self.show_status()
            return False

        def on_team(self, text, team):
            self.team_failed = False
            self.team_error.set_visible(False)
            if text != self.team_text:
                self.team_text, self.team = text, team
                self.redraw_team()
            self.show_status()
            return False

        def show_status(self):
            if self.view == "projects":
                if self.projects_failed:
                    self.status.set_text("projects not updated")
                else:
                    self.status.set_text("%d projects" % len(self.projects) if self.projects is not None else "loading…")
                return
            if self.view == "decisions":
                if self.decisions_failed:
                    self.status.set_text("decisions not updated")
                elif self.decisions_text is not None:
                    base = core.decisions_status(*self.decisions_counts())
                    if self.answer_url is None and not self.read_only_said:
                        self.read_only_said = True
                        self.status.set_text(base + " · read-only")
                    else:
                        self.status.set_text(base)
                else:
                    self.status.set_text("loading…")
            elif self.view == "team":
                if self.team_failed:
                    self.status.set_text("team not updated")
                else:
                    self.status.set_text("%d agents" % len(self.team) if self.team_text is not None else "loading…")
            elif self.events_failed:
                self.status.set_text("not updated")
            else:
                self.status.set_text("%d events · %s" % (len(self.events), "all" if self.show_all else "last %d" % core.LAST))

        def subrow_show(self, name):
            """The second button row: Show all and Reports in Events, only Actions in Decisions, hidden elsewhere."""
            self.subrow.set_visible(name in ("events", "decisions"))
            self.toggle.set_visible(name == "events")
            self.reports_button.set_visible(name == "events")
            self.actions_toggle.set_visible(name == "decisions")
            self.decisions_toggle.set_visible(name == "decisions")

        def decisions_counts(self):
            """(entries shown, Action entries hidden, Choice entries hidden)."""
            kept, ah, dh = core.filter_decisions(self.decisions, self.actions_shown, self.decisions_shown)
            return len(kept), ah, dh

        def on_actions(self, button):
            self.actions_shown = button.get_active()
            try:
                core.save_actions_shown(self.filter_path, self.actions_shown)
            except core.DashboardError as e:
                self.decisions_error.set_text(str(e))
                self.decisions_error.set_visible(self.view == "decisions")
            self.redraw_decisions()
            self.show_status()

        def on_decisions_toggle(self, button):
            self.decisions_shown = button.get_active()
            try:
                core.save_decisions_shown(self.filter_path, self.decisions_shown)
            except core.DashboardError as e:
                self.decisions_error.set_text(str(e))
                self.decisions_error.set_visible(self.view == "decisions")
            self.redraw_decisions()
            self.show_status()

        def on_view(self, button, name):
            if not button.get_active():
                return
            self.view = name
            if name == "events":  # a view switch starts every card normal
                self.born.clear()
                self.fade_tick()
            self.stack.set_visible_child_name(name)
            self.title_label.set_text({"team": "Team", "decisions": "Decisions", "projects": "Projects"}.get(name, "Gate events"))
            self.subrow_show(name)
            self.error.set_visible(name == "events" and self.events_failed)
            self.team_error.set_visible(name == "team" and self.team_failed)
            self.decisions_error.set_visible(name == "decisions" and self.decisions_failed)
            self.projects_error.set_visible(name == "projects" and self.projects_failed)
            self.show_status()

        def fetch_worker(self):
            try:
                text = core.fetch(url)
                events = core.parse_events(text)
                GLib.idle_add(self.on_data, text, events)
            except core.DashboardError as e:
                GLib.idle_add(self.on_error, str(e))

        def on_error(self, msg):
            self.error.set_text(msg + " (showing the last data)" if self.events else msg)
            self.events_failed = True
            self.error.set_visible(self.view == "events")
            self.show_status()
            return False

        def on_data(self, text, events):
            self.events_failed = False
            self.error.set_visible(False)
            if text != self.last_text:
                now = time.monotonic()
                for k in core.new_keys(self.seen, events):
                    self.born[k] = now
                self.seen = {core.event_key(e) for e in events} | (self.seen or set())
                self.last_text, self.events = text, events
                self.redraw()
            self.redraw_reports()  # the range holds more or fewer events as the clock moves
            self.show_status()
            if a.screenshot and not self.shot_done and a.view != "projects":  # the projects feed triggers its own shot
                self.shot_done = True
                GLib.timeout_add(int(a.screenshot_delay * 1000), self.screenshot)
            return False

        def on_key(self, _ctrl, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                if self.view == "projects" and self.pstate["open"]:
                    self.back_to_overview()
                    return True
                self.win.close()
                return True
            return False

        # -- reports --
        def build_reports(self):
            """The Reports pane: a title, the time-range choice, one area per chart (placeholders) or the empty text."""
            pane = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=36, margin_end=36, margin_top=10)
            title = self.label("Reports", "po-title")
            pane.append(title)
            choice = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            self.range_buttons = []
            first = None
            for i, (text, _secs) in enumerate(core.REPORT_RANGES):
                b = Gtk.ToggleButton(label=text, active=i == self.report_range, group=first)
                first = first or b
                b.add_css_class("po-small")
                b.connect("toggled", self.on_range, i)
                choice.append(b)
                self.range_buttons.append(b)
            pane.append(choice)
            self.chart_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            pane.append(self.chart_box)
            self.redraw_reports()
            scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            scroll.set_child(pane)
            return scroll

        def redraw_reports(self):
            child = self.chart_box.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.chart_box.remove(child)
                child = nxt
            secs = core.REPORT_RANGES[self.report_range][1]
            if not core.in_range(self.events, secs):
                self.chart_box.append(self.label(core.REPORT_EMPTY, "po-muted", margin_top=8))
                return
            layouts = (reports.layout_gate_runs, reports.layout_first_try, reports.layout_closed,
                       reports.layout_cycle_time, reports.layout_failed_legs)
            for (name, data, text), layout in zip(reports.reports(self.events, secs, tz=local_tz()), layouts):
                area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
                area.add_css_class("po-chart")
                area.append(self.label(name, "po-text"))
                if reports_empty(data):
                    area.append(self.label("none in this range", "po-muted"))
                else:
                    area.append(Chart(layout, data, text, self.dark()))
                self.chart_box.append(area)

        def on_range(self, button, i):
            if button.get_active():
                self.report_range = i
                self.redraw_reports()

        def on_reports(self, button):
            self.reports_on = button.get_active()
            self.events_stack.set_visible_child_name("reports" if self.reports_on else "list")

        def on_toggle(self, button):
            self.show_all = button.get_active()
            button.set_label("Show last %d" % core.LAST if self.show_all else "Show all")
            self.redraw()
            self.show_status()

        # -- column headers --
        def column_header(self, view, columns, note_slot=False):
            """A muted line of real buttons over a list's columns, in the columns' size groups; a click sorts by one."""
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, margin_start=34, margin_end=34, margin_top=4)
            for key, title, group, grow in columns:
                inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4, halign=Gtk.Align.START)
                inner.append(self.label(title, "po-muted", ellipsize=3))
                arrow = self.label("", "po-muted", width_chars=1)
                inner.append(arrow)
                b = Gtk.Button(hexpand=grow)
                b.set_child(inner)
                b.add_css_class("po-colhead")
                b.set_tooltip_text("sort by %s" % title)
                b.update_property([Gtk.AccessibleProperty.LABEL], ["sort by %s" % title])
                b.connect("clicked", self.on_sort, view, key)
                if group is not None:
                    group.add_widget(b)
                box.append(b)
                self.heads[view][key] = (b, arrow)
            if note_slot:
                box.append(Gtk.Box(width_request=24))
            return box

        def on_sort(self, _button, view, key):
            self.sorts[view] = core.next_sort(self.sorts[view], key)
            self.show_marks(view)
            if view == "events":
                self.redraw()
            else:
                self.redraw_team()

        def show_marks(self, view):
            for key, (_b, arrow) in self.heads[view].items():
                arrow.set_text(core.sort_mark(self.sorts[view], key))

        # -- drawing --
        def label(self, text, *classes, **kw):
            lab = Gtk.Label(label=text, xalign=0, **kw)
            for c in classes:
                lab.add_css_class(c)
            return lab

        def note_icon(self, detail):
            """The note slot's content: an icon whose tooltip and accessible label are the detail."""
            theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            name = next((n for n in core.NOTE_ICONS if theme.has_icon(n)), None)
            if name:
                note = Gtk.Image.new_from_icon_name(name)
            else:
                note = Gtk.Label(label=core.NOTE_FALLBACK)
            note.add_css_class("po-note")
            note.set_tooltip_text(detail)
            note.set_focusable(True)
            note.update_property([Gtk.AccessibleProperty.LABEL], [detail])
            return note

        def redraw(self):
            child = self.list.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.list.remove(child)
                child = nxt
            groups = self.event_groups
            note_group = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
            self.cards = []
            for ev in core.sorted_events(core.visible(self.events, self.show_all), self.sorts["events"]):
                r = core.row(ev)
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                card.add_css_class("po-card")
                key = core.event_key(ev)
                step = self.step_of(key)
                if step:
                    card.add_css_class("po-fade-%d" % step)
                self.cards.append((card, key, step))
                for (key, _title, width, widest, grow), group in zip(core.COLUMNS, groups):
                    cls = "po-" + r["result_class"] if key == "result" else "po-warn" if key == "took" and r["slow"] else "po-muted" if key in ("kind", "legs", "agent", "took", "time") else "po-text"
                    lab = self.label(r[key], cls, width_chars=width, max_width_chars=widest, hexpand=grow, ellipsize=3)
                    lab.set_tooltip_text(r[key])
                    group.add_widget(lab)
                    card.append(lab)
                slot = Gtk.Box(halign=Gtk.Align.CENTER)
                if r["detail"]:
                    slot.append(self.note_icon(r["detail"]))
                note_group.add_widget(slot)
                slot.set_size_request(24, -1)
                card.append(slot)
                self.list.append(card)

        def redraw_team(self):
            child = self.team_list.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.team_list.remove(child)
                child = nxt
            groups = self.team_groups
            sort = self.sorts["team"]
            rows = core.team_rows(core.sorted_team(core.apply_team_order(self.team, self.team_order), sort))
            any_model = any(r["model"] for r in rows)
            self.heads["team"]["model"][0].set_visible(any_model)
            self.team_shown = [r["agent"] for r in rows]
            self.team_cards = {}
            for r in rows:
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                card.add_css_class("po-card")
                card.add_css_class("po-team")
                self.make_movable(card, r["agent"])
                name = self.label(r["agent"], "po-text", width_chars=10, max_width_chars=16, ellipsize=3)
                model = self.label(r["model"], "po-muted", max_width_chars=28, ellipsize=3)
                model.set_tooltip_text(r["model"] or None)
                state = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                if r["kind"] == "working":
                    state.append(self.label("\u25cf", "po-live"))
                style = {"working": "po-live", "free": "po-free", "limit": "po-fail"}.get(r["kind"], "po-muted")
                state.append(self.label(r["status"], style, ellipsize=3, max_width_chars=28))
                if r["usage"]:
                    state.append(self.label(r["usage"], "po-muted", ellipsize=3, max_width_chars=20))
                now = self.label(("now " + r["now"]) if r["now"] else "", "po-text", width_chars=10, max_width_chars=16, ellipsize=3)
                owns = self.label(("owns " + r["owns"]) if r["owns"] else "owns nothing", "po-muted", hexpand=True, ellipsize=3)
                owns.set_tooltip_text(r["owns"])
                for w, g in zip((name, model, state, now), groups):
                    g.add_widget(w)
                for w in (name, model, state, now, owns) if any_model else (name, state, now, owns):
                    card.append(w)
                if sort is not None:
                    card.set_tooltip_text("%s: clear the column sort to reorder" % r["agent"])
                self.team_list.append(card)
                self.team_cards[r["agent"]] = card

        def redraw_decisions(self):
            self.decisions_expanded = core.prune_expanded(self.decisions_expanded, self.decisions)
            answer_ids = {str(e.get("id") or "") for e in self.decisions if e.get("id")}
            self.answers = {k: v for k, v in self.answers.items() if k in answer_ids}
            self.drafts = {k: v for k, v in self.drafts.items() if k in answer_ids}
            focus = None  # the answer box being typed in, given back its focus and cursor once rebuilt
            focused = self.win.get_focus()
            for (aid, field), view in self.answer_views.items():
                if view is focused:
                    buf = view.get_buffer()
                    focus = (aid, field, buf.get_iter_at_mark(buf.get_insert()).get_offset())
            focus = core.answer_focus(focus, self.decisions, self.answers)
            vadj = self.decisions_scroll.get_vadjustment()
            scroll = vadj.get_value()
            self.answer_views, self.asked_labels = {}, []
            child = self.decisions_list.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.decisions_list.remove(child)
                child = nxt
            groups = [Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL) for _ in range(4)]
            shown, _ah, _dh = core.filter_decisions(self.decisions, self.actions_shown, self.decisions_shown)
            plan = core.install_plan(shown, self.install_dir)
            marks = {k: m for b in plan.values() for k, m in b["mismatched"].items()}
            for entry in core.sort_decisions(shown):
                r = core.decision_row(entry)
                key = core.decision_key(entry)
                block = plan.pop(r["project"], None)  # once per project, above its first card
                if block is not None:
                    self.decisions_list.append(self.install_block(r["project"], block))
                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                card.add_css_class("po-card")
                top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                item = self.label(r["item"], "po-text", width_chars=6, max_width_chars=10, ellipsize=3)
                project = self.label(r["project"], "po-muted", width_chars=8, max_width_chars=20, ellipsize=3)
                title = self.label(r["title"], "po-text", hexpand=True, ellipsize=3)
                title.set_tooltip_text(r["title"] or None)
                waiting = self.label("waiting for " + r["waiting_for"], "po-muted", max_width_chars=24, ellipsize=3)
                asked = self.label("asked " + r["asked"], "po-muted", width_chars=14, max_width_chars=20, ellipsize=3)
                asked.set_tooltip_text(r["asked_local"] or None)
                self.asked_labels.append((asked, entry))
                if r.get("asked_by"):
                    asked_by = self.label(r["asked_by"], "po-muted", width_chars=8, max_width_chars=16, ellipsize=3)
                else:
                    asked_by = None
                for w, g in zip((item, project, waiting, asked), groups):
                    g.add_widget(w)
                badge = self.label(core.DECISION_BADGE[r["kind"]], "po-kind", "po-kind-" + r["kind"], width_chars=11)  # empty for legacy: keeps the columns aligned
                if r["kind"] != "legacy":
                    badge.set_tooltip_text(r["kind"])
                for w in (badge, item, project, title, asked, asked_by):
                    if w is not None:
                        top.append(w)
                expanded = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                expanded.set_visible(key in self.decisions_expanded)
                self.fill_decision(expanded, r)
                if r["kind"] != "legacy" and r["id"]:
                    self.fill_answer(expanded, r, key)
                # collapsed header: click toggles the full waiting_for
                header = Gtk.Button()
                header.set_child(top)
                header.connect("clicked", self.on_decision_toggle, expanded, key)
                card.append(header)
                if key in marks:
                    card.append(self.label(marks[key], "po-warn", wrap=True))
                card.append(expanded)
                if r["thread_url"]:
                    url = self.label(r["thread_url"], "po-muted", selectable=True, ellipsize=2)
                    url.set_tooltip_text(r["thread_url"])
                    card.append(url)
                self.decisions_list.append(card)
            view = self.answer_views.get(focus[:2]) if focus else None
            if view is not None:
                buf = view.get_buffer()
                buf.place_cursor(buf.get_iter_at_offset(focus[2]))
                view.grab_focus()
            GLib.idle_add(lambda: vadj.set_value(scroll) and False)

        def command_row(self, command, margin=36):
            """A command in its own selectable monospace block with a Copy button."""
            cmd = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin_start=margin)
            lab = Gtk.Label(label=command, xalign=0, wrap=True, selectable=True, hexpand=True, css_classes=["monospace"])
            lab.add_css_class("po-muted")
            cmd.append(lab)
            copy = Gtk.Button(label="Copy")
            copy.add_css_class("po-small")
            copy.connect("clicked", self.on_copy, command)
            cmd.append(copy)
            return cmd

        def install_block(self, project, block):
            """One project's `Install this build` card: the package, then the sha256 check and the install, or the note."""
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            card.add_css_class("po-card")
            card.append(self.label("Install this build \u00b7 %s" % project, "po-kind", "po-kind-action"))
            card.append(self.label(block["package"], "po-text", selectable=True, wrap=True))
            if block["commands"]:
                for command in block["commands"]:
                    card.append(self.command_row(command, margin=12))
            else:
                card.append(self.label(block["note"], "po-warn"))
            return card

        def fill_decision(self, box, r):
            """The expanded part of a card: the full waiting_for, then the question and options or the steps."""
            def text(s, *classes, **kw):
                lab = Gtk.Label(label=s, xalign=0, wrap=True, selectable=True, **kw)
                for c in classes:
                    lab.add_css_class(c)
                return lab
            box.append(text(r["waiting_for"], "po-muted"))
            if r["kind"] == "choice":
                box.append(text(r["question"], "po-text"))
                for n, o in enumerate(r["options"], 1):
                    line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin_start=12)
                    line.append(self.label("%d." % n, "po-muted"))
                    line.append(text(o["label"], "po-text"))
                    if o["recommended"]:
                        line.append(self.label("recommended", "po-kind", "po-kind-choice"))
                    box.append(line)
                    if o["description"]:
                        box.append(text(o["description"], "po-muted", margin_start=36))
            elif r["kind"] == "action":
                box.append(text("on " + r["machine"], "po-text"))
                if r["requires"]:
                    box.append(text("build: " + r["requires"]["package"], "po-muted"))
                for st in r["steps"]:
                    box.append(text("%d. %s" % (st["n"], st["text"]), "po-text", margin_start=12))
                    if st["command"]:
                        box.append(self.command_row(st["command"]))
                box.append(text("done when: " + r["done_when"], "po-muted"))

        def on_copy(self, button, command):
            """Puts the command on the clipboard and nothing else; the dashboard never runs it."""
            button.get_clipboard().set(command)

        def on_decision_toggle(self, _button, box, key):
            self.decisions_expanded = core.toggle_expanded(self.decisions_expanded, key)
            box.set_visible(key in self.decisions_expanded)

        def fill_answer(self, box, r, key):
            """The answer controls (or sent/failed state) at the bottom of an expanded card."""
            aid = r["id"]
            ans = self.answers.get(aid)
            if ans:
                box.append(self.label(ans["display"], core.answer_state_class(ans["display"]), margin_top=6))
                if core.answer_needs_retry(ans["display"]):
                    retry = Gtk.Button(label="Retry")
                    retry.add_css_class("po-small")
                    retry.connect("clicked", self.on_retry_answer, aid)
                    box.append(retry)
                return
            if not self.answer_url:
                box.append(self.label("read-only", "po-muted", margin_top=6))
                return
            # read-write: controls based on kind. picks holds the draft in a closure dict.
            draft = self.drafts.get(aid, {})
            picks = {"choice": draft.get("choice"), "text": draft.get("text", ""), "result": draft.get("result"), "step": draft.get("step"), "note": draft.get("note", "")}
            controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin_top=6)
            send = Gtk.Button(label="Send")
            send.add_css_class("po-small")
            send.set_sensitive(False)
            if r["kind"] == "choice":
                group = None
                for n, o in enumerate(r["options"]):
                    btn = Gtk.ToggleButton(label=o["label"], group=group)
                    if group is None:
                        group = btn
                    if draft.get("choice") == o["label"]:
                        btn.set_active(True)
                    btn.connect("toggled", self.on_choice_pick, aid, o["label"], send, picks)
                    controls.append(btn)
                write_in, write_in_view = self.answer_box("or write your own", draft.get("note"), send, picks)
                write_in_view.get_buffer().connect("changed", self.on_answer_note, aid, "choice", send, picks)
                self.answer_views[(aid, "note")] = write_in_view
                controls.append(write_in)
            elif r["kind"] == "action":
                group = None
                for label in ("Pass", "Failed"):
                    btn = Gtk.ToggleButton(label=label, group=group)
                    if group is None:
                        group = btn
                    if draft.get("result") == label:
                        btn.set_active(True)
                    btn.connect("toggled", self.on_action_result, aid, label, send, picks)
                    controls.append(btn)
                step_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, visible=False)
                step_group = None
                for n in range(1, len(r["steps"]) + 1):
                    btn = Gtk.ToggleButton(label=str(n), group=step_group)
                    if step_group is None:
                        step_group = btn
                    btn.set_size_request(32, -1)
                    if draft.get("step") == n:
                        btn.set_active(True)
                    btn.connect("toggled", self.on_action_step, aid, n, send, picks)
                    step_box.append(btn)
                controls.append(step_box)
                note, note_view = self.answer_box("note", draft.get("note"), send, picks)
                note_view.get_buffer().connect("changed", self.on_answer_note, aid, "action", send, picks)
                self.answer_views[(aid, "note")] = note_view
                controls.append(note)
                picks["step_box"] = step_box
            else:  # unformatted
                text, text_view = self.answer_box("Type your answer…", draft.get("text"), send, picks)
                text.set_hexpand(True)
                text_view.get_buffer().connect("changed", self.on_answer_text, aid, send, picks)
                self.answer_views[(aid, "text")] = text_view
                controls.append(text)
            if r["kind"] == "action" and picks.get("result") == "Failed" and picks.get("step_box"):
                picks["step_box"].set_visible(True)
            send.set_sensitive(core.answer_ready(r["kind"], picks))
            send.connect("clicked", self.on_send_answer, aid, r, picks)
            controls.append(send)
            box.append(controls)

        def answer_box(self, placeholder, initial, send, picks):
            """A multi-line answer box: (widget, TextView). Grows to about 8 lines, then scrolls.

            The widget holds the scrolled TextView (placeholder drawn as an overlay label,
            hidden once the buffer has text) and the n / 2000 counter. Enter inserts a newline;
            Ctrl+Enter presses Send when it is sensitive.
            """
            view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, accepts_tab=False)
            view.set_top_margin(4)
            view.set_bottom_margin(4)
            view.set_left_margin(6)
            view.set_right_margin(6)
            line = max(view.create_pango_layout("Mg").get_pixel_size()[1], 16) + 8
            scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            scroller.set_propagate_natural_height(True)
            scroller.set_min_content_height(line)
            scroller.set_max_content_height(line * 8)
            scroller.set_child(view)
            scroller.set_hexpand(True)
            hint = Gtk.Label(label=placeholder, xalign=0, halign=Gtk.Align.START, valign=Gtk.Align.START, margin_start=7, margin_top=4)
            hint.add_css_class("po-muted")
            hint.set_can_target(False)
            overlay = Gtk.Overlay()
            overlay.set_child(scroller)
            overlay.add_overlay(hint)
            counter = Gtk.Label(label="", xalign=1)
            counter.add_css_class("po-muted")
            buf = view.get_buffer()

            def refresh(_buf=None):
                text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
                hint.set_visible(not text)
                label, over = core.answer_counter(text)
                counter.set_text(label)
                if over:
                    counter.remove_css_class("po-muted")
                    counter.add_css_class("po-error")
                else:
                    counter.remove_css_class("po-error")
                    counter.add_css_class("po-muted")

            if initial:
                buf.set_text(initial)
            buf.connect("changed", refresh)
            refresh()
            keys = Gtk.EventControllerKey()

            def on_key(_ctl, keyval, _code, state):
                if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and state & Gdk.ModifierType.CONTROL_MASK:
                    if send.get_sensitive():
                        send.emit("clicked")
                    return True
                return False

            keys.connect("key-pressed", on_key)
            view.add_controller(keys)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            box.append(overlay)
            box.append(counter)
            return box, view

        def _draft_changed(self, aid, kind, send, picks):
            """Store the draft and set Send from the one readiness rule."""
            send.set_sensitive(core.answer_ready(kind, picks))
            self.drafts[aid] = {k: v for k, v in picks.items() if k != "step_box"}

        def on_choice_pick(self, button, aid, label, send, picks):
            """A choice radio was toggled; store the option."""
            if button.get_active():
                picks["choice"] = label
            elif picks.get("choice") == label:
                picks["choice"] = None
            self._draft_changed(aid, "choice", send, picks)

        def on_action_result(self, button, aid, label, send, picks):
            """Pass/Failed was toggled; Failed shows the step chooser."""
            if not button.get_active():
                return
            if label == "Failed" and picks.get("step_box"):
                picks["step_box"].set_visible(True)
            picks["result"] = label
            self._draft_changed(aid, "action", send, picks)

        def on_action_step(self, button, aid, step, send, picks):
            """A step number was chosen for Failed."""
            if not button.get_active():
                return
            picks["step"] = step
            self._draft_changed(aid, "action", send, picks)

        def on_answer_note(self, buf, aid, kind, send, picks):
            """The note or write-your-own text box changed; kept as typed (answer_params trims it)."""
            picks["note"] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
            self._draft_changed(aid, kind, send, picks)

        def on_answer_text(self, buf, aid, send, picks):
            """The unformatted text box changed; kept as typed (answer_params trims it)."""
            picks["text"] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
            self._draft_changed(aid, "unformatted", send, picks)

        def on_send_answer(self, button, aid, r, picks):
            """Build the body, stash the draft, POST in a worker thread."""
            kind = r["kind"]
            params = core.answer_params(kind, picks)
            body = core.answer_body(r, core.answer_id(), **params)
            self.answers[aid] = {"answer_id": body["answer_id"], "body": body, "display": "sending…"}
            self.drafts.pop(aid, None)
            button.set_sensitive(False)
            threading.Thread(target=self._send_answer, args=(aid, body), daemon=True).start()

        def on_retry_answer(self, button, aid):
            """Re-post the same body (same answer_id)."""
            body = self.answers[aid]["body"]
            self.answers[aid]["display"] = "sending…"
            button.set_sensitive(False)
            threading.Thread(target=self._send_answer, args=(aid, body), daemon=True).start()

        def _send_answer(self, aid, body):
            """Worker thread: POST and queue the state update on the main thread."""
            display = core.post_answer(self.answer_url, body, self.answer_token)
            GLib.idle_add(self.on_answer_state, aid, display)

        def on_answer_state(self, aid, display):
            """The POST finished; store the display string and redraw the card."""
            if aid in self.answers:
                self.answers[aid]["display"] = display
                self.redraw_decisions()

        def make_movable(self, card, agent):
            """Drag the line onto another to take its place; Alt+Up/Down moves the focused line."""
            from gi.repository import GObject

            card.set_focusable(True)
            card.set_tooltip_text("%s: drag, or Alt+Up/Down, to reorder" % agent)
            src = Gtk.DragSource(actions=Gdk.DragAction.MOVE)
            src.connect("prepare", lambda *_: Gdk.ContentProvider.new_for_value(agent))
            src.connect("drag-begin", lambda s, _drag: s.set_icon(Gtk.WidgetPaintable.new(card), 20, 20))
            card.add_controller(src)
            dst = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE)
            dst.connect("enter", lambda *_: card.add_css_class("po-drop") or Gdk.DragAction.MOVE)
            dst.connect("leave", lambda *_: card.remove_css_class("po-drop"))
            dst.connect("drop", lambda _t, value, _x, _y: self.move_team(value, self.team_shown.index(agent)) if agent in self.team_shown else False)
            card.add_controller(dst)
            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self.on_team_key, agent)
            card.add_controller(keys)

        def on_team_key(self, _ctrl, keyval, _code, state, agent):
            if not state & Gdk.ModifierType.ALT_MASK or keyval not in (Gdk.KEY_Up, Gdk.KEY_Down) or agent not in self.team_shown:
                return False
            self.move_team(agent, self.team_shown.index(agent) + (-1 if keyval == Gdk.KEY_Up else 1))
            return True

        def move_team(self, agent, index):
            """Move agent to index, save the order on this machine, redraw and keep the focus on its line."""
            if self.sorts["team"] is not None:  # the shown order is the sort's, never the saved one
                return True
            shown = core.move_agent(self.team_shown, agent, index)
            if shown == self.team_shown:
                return True
            self.team_order = core.merge_team_order(shown, self.team_order)
            try:
                core.save_team_order(self.order_path, self.team_order)
            except core.DashboardError as e:
                self.team_error.set_text(str(e))
                self.team_error.set_visible(True)
            self.redraw_team()
            card = self.team_cards.get(agent)
            if card is not None:
                GLib.idle_add(card.grab_focus)
            return True

        def screenshot(self):
            w, h = self.win.get_width(), self.win.get_height()
            snap = Gtk.Snapshot()
            Gtk.WidgetPaintable.new(self.win).snapshot(snap, w, h)
            node = snap.to_node()
            tex = self.win.get_native().get_renderer().render_texture(node, None)
            tex.save_to_png(a.screenshot)
            self.win.get_application().quit()
            return False

    flags = Gio.ApplicationFlags.NON_UNIQUE if (a.screenshot or a.check) else 0
    app = Gtk.Application(application_id="dev.pokit.Dashboard", flags=flags)
    app.connect("activate", lambda application: Dashboard(application))
    sys.exit(app.run([sys.argv[0]]))


if __name__ == "__main__":
    main()
