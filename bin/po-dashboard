#!/usr/bin/env python3
"""po-dashboard: a desktop window showing the gate events of a po serve.

    po-dashboard [--url <url>] [--team-url <url>] [--view events|team] [--theme auto|light|dark] [--all] [--size WxH] [--check] [--screenshot <png>] [--screenshot-delay <s>]

The URL is the events JSON (a JSON array or one object per line, e.g. the
/events.json of `po serve`); --url or PO_DASHBOARD_URL, no default. GTK 4 and
PyGObject (pacman -S gtk4 python-gobject); the logic is lib/po/dashboard_core.py.
--team-url or PO_DASHBOARD_TEAM_URL (no default) adds a Team view, a header toggle Events | Team, reading a
JSON array of {agent, model?, state, now, owns[], free}; without it there is no toggle. Esc closes the window. Exit codes: 1 usage, 2 GTK or PyGObject missing
(or, with --check, the feed unreachable).
"""
import argparse
import os
import sys
import threading
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "po"))
import dashboard_core as core  # noqa: E402


def die(msg, code=1):
    sys.stderr.write("po-dashboard: %s\n" % msg)
    sys.exit(code)


def load_gtk():
    try:
        import gi

        gi.require_version("Gtk", "4.0")
        gi.require_version("Gdk", "4.0")
        from gi.repository import GLib, Gdk, Gtk
    except (ImportError, ValueError, AttributeError) as e:
        die("needs GTK 4 and PyGObject (pacman -S gtk4 python-gobject): %s" % e, 2)
    return GLib, Gdk, Gtk


def main():
    ap = argparse.ArgumentParser(prog="po-dashboard", add_help=True)
    ap.add_argument("--url", help="events JSON URL (default: $%s)" % core.URL_ENV)
    ap.add_argument("--team-url", help="team feed JSON URL or file (default: $%s; none = no Team view)" % core.TEAM_URL_ENV)
    ap.add_argument("--view", choices=("events", "team"), default="events", help="the view to start in (team needs a team feed)")
    ap.add_argument("--theme", choices=("auto", "light", "dark"), default="auto")
    ap.add_argument("--all", action="store_true", help="start with every event shown (Show all on)")
    ap.add_argument("--size", metavar="WxH", default="760x640", help="initial window size (default 760x640)")
    ap.add_argument("--check", action="store_true", help="print the rows the window would show, without a display")
    ap.add_argument("--screenshot", metavar="PNG", help="save the window once it has data, then quit")
    ap.add_argument("--screenshot-delay", metavar="SECONDS", type=float, default=0.6, help="wait this long after the first data before the screenshot (default 0.6)")
    a = ap.parse_args()
    try:
        width, height = (int(n) for n in a.size.lower().split("x"))
        if width < 200 or height < 200:
            raise ValueError
    except ValueError:
        ap.error("--size must be WxH, both at least 200")
    try:
        url = core.resolve_url(a.url)
        team_url = core.resolve_team_url(a.team_url)
    except core.DashboardError as e:
        die(str(e))
    if a.view == "team" and not team_url:
        die("--view team needs a team feed: pass --team-url or set %s" % core.TEAM_URL_ENV)
    if a.check:
        try:
            print("\n".join(core.check_lines(core.parse_events(core.fetch(url)), a.all)))
            if team_url:
                print("team:")
                print("\n".join(core.team_check_lines(core.parse_team(core.fetch(team_url)))))
        except core.DashboardError as e:
            die(str(e), 2)
        return
    GLib, Gdk, Gtk = load_gtk()

    class Dashboard:
        def __init__(self, app):
            self.show_all = a.all
            self.events = []
            self.seen = None  # event keys already shown; None until the first fetch, so nothing is new then
            self.born = {}  # event key -> time.monotonic() when it appeared while the window was open
            self.cards = []  # (card, event key, highlight step now) of the Events view
            self.team = []
            self.team_text = None
            self.view = "events"
            self.events_failed = False
            self.team_failed = False
            self.last_text = None
            self.provider = None
            self.shot_done = False
            self.win = Gtk.ApplicationWindow(application=app, title="po events")
            self.win.set_default_size(width, height)
            self.win.add_css_class("po-dashboard")

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            header.add_css_class("po-header")
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            title = self.title_label = Gtk.Label(label="Gate events", xalign=0)
            title.add_css_class("po-title")
            self.status = Gtk.Label(label="loading…", xalign=0)
            self.status.add_css_class("po-status")
            texts.append(title)
            texts.append(self.status)
            self.toggle = Gtk.ToggleButton(label="Show all")
            self.toggle.add_css_class("po-toggle")
            self.toggle.set_valign(Gtk.Align.CENTER)
            if a.all:
                self.toggle.set_active(True)
                self.toggle.set_label("Show last %d" % core.LAST)
            self.toggle.connect("toggled", self.on_toggle)
            header.append(texts)
            if team_url:
                views = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, valign=Gtk.Align.CENTER)
                self.btn_events = Gtk.ToggleButton(label="Events", active=True)
                self.btn_team = Gtk.ToggleButton(label="Team", group=self.btn_events)
                for b, name in ((self.btn_events, "events"), (self.btn_team, "team")):
                    b.add_css_class("po-view")
                    b.connect("toggled", self.on_view, name)
                    views.append(b)
                header.append(views)
            header.append(self.toggle)

            self.error = Gtk.Label(label="", xalign=0, wrap=True, margin_start=36, margin_end=36)
            self.error.add_css_class("po-error")
            self.error.set_visible(False)
            self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.list.add_css_class("po-list")
            scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            scroll.set_child(self.list)
            self.team_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.team_list.add_css_class("po-list")
            team_scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            team_scroll.set_child(self.team_list)
            self.stack = Gtk.Stack(vexpand=True)
            self.stack.add_named(scroll, "events")
            self.stack.add_named(team_scroll, "team")
            self.team_error = Gtk.Label(label="", xalign=0, wrap=True, margin_start=36, margin_end=36)
            self.team_error.add_css_class("po-error")
            self.team_error.set_visible(False)

            outer.append(header)
            outer.append(self.error)
            outer.append(self.team_error)
            outer.append(self.stack)
            self.win.set_child(outer)
            if team_url and a.view == "team":
                self.btn_team.set_active(True)

            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self.on_key)
            self.win.add_controller(keys)

            self.settings = Gtk.Settings.get_default()
            for prop in ("gtk-application-prefer-dark-theme", "gtk-interface-color-scheme"):
                try:
                    self.settings.connect("notify::" + prop, lambda *_: self.apply_css())
                except TypeError:
                    pass
            self.apply_css()
            self.win.present()
            self.refresh()
            GLib.timeout_add(core.INTERVAL_MS, self.tick)
            GLib.timeout_add(500, self.fade_tick)

        # -- style --
        def dark(self):
            if a.theme != "auto":
                return a.theme == "dark"
            s = self.settings
            try:
                if s.get_property("gtk-interface-color-scheme") == Gtk.InterfaceColorScheme.DARK:
                    return True
            except (TypeError, AttributeError):
                pass
            return bool(s.get_property("gtk-application-prefer-dark-theme"))

        def apply_css(self):
            display = Gdk.Display.get_default()
            if self.provider is not None:
                Gtk.StyleContext.remove_provider_for_display(display, self.provider)
            self.provider = Gtk.CssProvider()
            text = core.css("dark" if self.dark() else "light")
            if hasattr(self.provider, "load_from_string"):
                self.provider.load_from_string(text)
            else:
                self.provider.load_from_data(text.encode("utf-8"))
            Gtk.StyleContext.add_provider_for_display(display, self.provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        # -- the new-event highlight --
        def step_of(self, key):
            born = self.born.get(key)
            if born is None:
                return 0
            reduced = not self.settings.get_property("gtk-enable-animations")
            return core.fade_step(time.monotonic() - born, reduced)

        def fade_tick(self):
            for i, (card, key, step) in enumerate(self.cards):
                n = self.step_of(key)
                if n != step:
                    if step:
                        card.remove_css_class("po-fade-%d" % step)
                    if n:
                        card.add_css_class("po-fade-%d" % n)
                    self.cards[i] = (card, key, n)
            return True

        # -- data --
        def tick(self):
            self.refresh()
            return True

        def refresh(self):
            threading.Thread(target=self.fetch_worker, daemon=True).start()
            if team_url:
                threading.Thread(target=self.team_worker, daemon=True).start()

        def team_worker(self):
            try:
                text = core.fetch(team_url)
                GLib.idle_add(self.on_team, text, core.parse_team(text))
            except core.DashboardError as e:
                GLib.idle_add(self.on_team_error, str(e))

        def on_team_error(self, msg):
            self.team_error.set_text(msg + " (showing the last team data)" if self.team_text is not None else msg)
            self.team_failed = True
            self.team_error.set_visible(self.view == "team")
            self.show_status()
            return False

        def on_team(self, text, team):
            self.team_failed = False
            self.team_error.set_visible(False)
            if text != self.team_text:
                self.team_text, self.team = text, team
                self.redraw_team()
            self.show_status()
            return False

        def show_status(self):
            if self.view == "team":
                if self.team_failed:
                    self.status.set_text("team not updated")
                else:
                    self.status.set_text("%d agents" % len(self.team) if self.team_text is not None else "loading…")
            elif self.events_failed:
                self.status.set_text("not updated")
            else:
                self.status.set_text("%d events · %s" % (len(self.events), "all" if self.show_all else "last %d" % core.LAST))

        def on_view(self, button, name):
            if not button.get_active():
                return
            self.view = name
            if name == "events":  # a view switch starts every card normal
                self.born.clear()
                self.fade_tick()
            self.stack.set_visible_child_name(name)
            self.title_label.set_text("Team" if name == "team" else "Gate events")
            self.toggle.set_visible(name == "events")
            self.error.set_visible(name == "events" and self.events_failed)
            self.team_error.set_visible(name == "team" and self.team_failed)
            self.show_status()

        def fetch_worker(self):
            try:
                text = core.fetch(url)
                events = core.parse_events(text)
                GLib.idle_add(self.on_data, text, events)
            except core.DashboardError as e:
                GLib.idle_add(self.on_error, str(e))

        def on_error(self, msg):
            self.error.set_text(msg + " (showing the last data)" if self.events else msg)
            self.events_failed = True
            self.error.set_visible(self.view == "events")
            self.show_status()
            return False

        def on_data(self, text, events):
            self.events_failed = False
            self.error.set_visible(False)
            if text != self.last_text:
                now = time.monotonic()
                for k in core.new_keys(self.seen, events):
                    self.born[k] = now
                self.seen = {core.event_key(e) for e in events} | (self.seen or set())
                self.last_text, self.events = text, events
                self.redraw()
            self.show_status()
            if a.screenshot and not self.shot_done:
                self.shot_done = True
                GLib.timeout_add(int(a.screenshot_delay * 1000), self.screenshot)
            return False

        def on_key(self, _ctrl, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                self.win.close()
                return True
            return False

        def on_toggle(self, button):
            self.show_all = button.get_active()
            button.set_label("Show last %d" % core.LAST if self.show_all else "Show all")
            self.redraw()
            self.show_status()

        # -- drawing --
        def label(self, text, *classes, **kw):
            lab = Gtk.Label(label=text, xalign=0, **kw)
            for c in classes:
                lab.add_css_class(c)
            return lab

        def note_icon(self, detail):
            """The note slot's content: an icon whose tooltip and accessible label are the detail."""
            theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            name = next((n for n in core.NOTE_ICONS if theme.has_icon(n)), None)
            if name:
                note = Gtk.Image.new_from_icon_name(name)
            else:
                note = Gtk.Label(label=core.NOTE_FALLBACK)
            note.add_css_class("po-note")
            note.set_tooltip_text(detail)
            note.set_focusable(True)
            note.update_property([Gtk.AccessibleProperty.LABEL], [detail])
            return note

        def redraw(self):
            child = self.list.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.list.remove(child)
                child = nxt
            groups = [Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL) for _ in core.COLUMNS]
            note_group = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
            self.cards = []
            for ev in core.visible(self.events, self.show_all):
                r = core.row(ev)
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                card.add_css_class("po-card")
                key = core.event_key(ev)
                step = self.step_of(key)
                if step:
                    card.add_css_class("po-fade-%d" % step)
                self.cards.append((card, key, step))
                for (key, _title, width, widest, grow), group in zip(core.COLUMNS, groups):
                    cls = "po-" + r["result_class"] if key == "result" else "po-muted" if key in ("kind", "legs", "agent", "time") else "po-text"
                    lab = self.label(r[key], cls, width_chars=width, max_width_chars=widest, hexpand=grow, ellipsize=3)
                    lab.set_tooltip_text(r[key])
                    group.add_widget(lab)
                    card.append(lab)
                slot = Gtk.Box(halign=Gtk.Align.CENTER)
                if r["detail"]:
                    slot.append(self.note_icon(r["detail"]))
                note_group.add_widget(slot)
                slot.set_size_request(24, -1)
                card.append(slot)
                self.list.append(card)

        def redraw_team(self):
            child = self.team_list.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.team_list.remove(child)
                child = nxt
            groups = [Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL) for _ in range(5)]
            rows = core.team_rows(self.team)
            any_model = any(r["model"] for r in rows)
            for r in rows:
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                card.add_css_class("po-card")
                name = self.label(r["agent"], "po-text", width_chars=10, max_width_chars=16, ellipsize=3)
                model = self.label(r["model"], "po-muted", max_width_chars=28, ellipsize=3)
                model.set_tooltip_text(r["model"] or None)
                state = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                if r["working"]:
                    state.append(self.label("\u25cf", "po-live"))
                    state.append(self.label(r["state"], "po-live", ellipsize=3, max_width_chars=24))
                else:
                    state.append(self.label(r["state"], "po-muted", ellipsize=3, max_width_chars=24))
                now = self.label(("now " + r["now"]) if r["now"] else "", "po-text", width_chars=10, max_width_chars=16, ellipsize=3)
                owns = self.label(("owns " + r["owns"]) if r["owns"] else "owns nothing", "po-muted", hexpand=True, ellipsize=3)
                owns.set_tooltip_text(r["owns"])
                badge = Gtk.Box(halign=Gtk.Align.END)
                if r["free"]:
                    badge.append(self.label("FREE", "po-free"))
                for w, g in zip((name, model, state, now, badge), groups):
                    g.add_widget(w)
                for w in (name, model, state, now, owns, badge) if any_model else (name, state, now, owns, badge):
                    card.append(w)
                self.team_list.append(card)

        def screenshot(self):
            w, h = self.win.get_width(), self.win.get_height()
            snap = Gtk.Snapshot()
            Gtk.WidgetPaintable.new(self.win).snapshot(snap, w, h)
            node = snap.to_node()
            tex = self.win.get_native().get_renderer().render_texture(node, None)
            tex.save_to_png(a.screenshot)
            self.win.get_application().quit()
            return False

    app = Gtk.Application(application_id="dev.pokit.Dashboard")
    app.connect("activate", lambda application: Dashboard(application))
    sys.exit(app.run([sys.argv[0]]))


if __name__ == "__main__":
    main()
