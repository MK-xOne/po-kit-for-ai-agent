#!/usr/bin/env bash
# po-install [<tag>] — install a tag of po-kit and make it the live `po`.
#
# The tag (default: the newest v<number> tag) is checked out with
# `git worktree add --detach` under ~/.local/share/po-kit/<tag>, and
# ~/.local/bin/po is pointed at its bin/po, so a half-done change on main
# is never live. Never from a branch, and never from a dirty checkout.
# Before switching, every adopter in ~/.config/po-kit/adopters is run under
# the installed po and under the new one (`po -C <repo> status`): a tag that
# fails (exit 2) where the installed one did not is refused and the symlink
# stays. After switching, `po doctor` runs. Never pushes, never edits an
# adopter. Exit: 0 ok, 1 usage, 2 environment (no tags, not a git checkout),
# 6 refused, 7 switched but po doctor reported failures.
set -euo pipefail

usage() {
	cat <<'USAGE'
usage: po-install [<tag>]

Install a po-kit tag (default: the newest) under ~/.local/share/po-kit/<tag>
and point ~/.local/bin/po at it; print the old and new tag; run po doctor.
Refuses a branch, a dirty checkout, and a tag whose po fails on an adopter
manifest the installed one reads (the symlink stays).
exit: 0 ok, 1 usage, 2 environment, 6 refused, 7 switched, po doctor failed
USAGE
}

die() {
	local code=$1
	shift
	printf 'po-install: %s\n' "$*" >&2
	exit "$code"
}

TAG_RE='^v[0-9]+(\.[0-9]+)+$'
case ${1:-} in
-h | --help)
	usage
	exit 0
	;;
-*)
	usage >&2
	exit 1
	;;
esac
(($# <= 1)) || {
	usage >&2
	exit 1
}
HOME_DIR=${HOME:?HOME is not set}
DATA=$HOME_DIR/.local/share/po-kit
LINK=$HOME_DIR/.local/bin/po
ADOPTERS=$HOME_DIR/.config/po-kit/adopters
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die 2 "$ROOT is not a git checkout"

tag=${1:-}
if [[ -z $tag ]]; then
	while IFS= read -r t; do
		[[ $t =~ $TAG_RE ]] && tag=$t && break
	done < <(git -C "$ROOT" tag --sort=-v:refname)
	[[ -n $tag ]] || die 2 "no v<number> tag in $ROOT"
fi
if [[ ! $tag =~ $TAG_RE ]] || ! git -C "$ROOT" rev-parse -q --verify "refs/tags/$tag^{commit}" >/dev/null; then
	die 6 "'$tag' is not a tag of $ROOT; po-install installs tags only"
fi
commit=$(git -C "$ROOT" rev-parse "refs/tags/$tag^{commit}")
dir=$DATA/$tag

[[ ! -e $LINK || -L $LINK ]] || die 6 "$LINK exists and is not a symlink; not replacing it"

# The label of what is live now.
old='(none)'
if [[ -L $LINK ]]; then
	target=$(readlink -f "$LINK" || true)
	if [[ $target == "$DATA"/*/bin/po ]]; then
		old=${target#"$DATA"/}
		old=${old%%/*}
	elif [[ -e $target ]]; then
		old=$(git -C "$(dirname "$target")" describe --tags --always --dirty 2>/dev/null || echo '(unknown)')
	else
		old='(dangling)'
	fi
fi

created=0
if [[ -e $dir ]]; then
	[[ $(git -C "$dir" rev-parse HEAD 2>/dev/null || true) == "$commit" ]] ||
		die 6 "$dir exists but is not a checkout of $tag"
	[[ -z $(git -C "$dir" status --porcelain --untracked-files=all) ]] ||
		die 6 "$dir is not a clean checkout of $tag"
else
	mkdir -p "$DATA"
	git -C "$ROOT" worktree add -q --detach "$dir" "$tag" || die 2 "git worktree add failed for $tag"
	created=1
fi

# Every adopter under the installed po and under the new one.
if [[ -f $ADOPTERS ]]; then
	while IFS= read -r line || [[ -n $line ]]; do
		line=${line#"${line%%[![:blank:]]*}"}
		line=${line%"${line##*[![:blank:]]}"}
		[[ -z $line || $line == '#'* ]] && continue
		# shellcheck disable=SC2088 # matching the literal text "~/"
		[[ $line == '~/'* ]] && line=$HOME_DIR/${line#'~/'}
		[[ -d $line && -x $LINK ]] || continue
		old_code=0 new_code=0
		"$LINK" -C "$line" status >/dev/null 2>&1 || old_code=$?
		new_out=$("$dir/bin/po" -C "$line" status 2>&1 >/dev/null) || new_code=$?
		if ((old_code != 2 && new_code == 2)); then
			((created == 0)) || git -C "$ROOT" worktree remove "$dir" >/dev/null 2>&1 || true
			die 6 "$tag breaks the adopter $line, which $old reads: ${new_out%%$'\n'*}; nothing switched"
		fi
	done <"$ADOPTERS"
fi

mkdir -p "$(dirname "$LINK")"
ln -s "$dir/bin/po" "$LINK.new.$$"
mv -T "$LINK.new.$$" "$LINK"
if [[ $old == "$tag" ]]; then
	printf 'po-install: %s -> %s (unchanged)\n' "$old" "$tag"
else
	printf 'po-install: %s -> %s\n' "$old" "$tag"
fi

if [[ ! -f $ADOPTERS ]]; then
	printf 'po-install: no adopters list (%s); po doctor not run\n' "$ADOPTERS"
elif ! "$LINK" version >/dev/null 2>&1; then
	printf 'po-install: %s has no po doctor\n' "$tag"
else
	code=0
	"$LINK" doctor || code=$?
	((code == 0)) || die 7 "switched to $tag, but po doctor reported failures; the switch stands"
fi
